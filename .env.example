# --- Database -------------------------------------------------------------
# Local docker-compose default:
DATABASE_URL=postgresql+psycopg://rwa:rwa_dev_password@localhost:5432/rwa_diligence
# For unit tests without Postgres you may use: sqlite:///./dev.db

# --- LLM provider: openrouter | claude | openai | gemini | mock ------------
# RECOMMENDED: openrouter (one key, any model).
LLM_PROVIDER=openrouter
# OpenRouter model ids, e.g.:
#   anthropic/claude-sonnet-4, openai/gpt-4o-mini, google/gemini-2.0-flash-001
LLM_MODEL=anthropic/claude-sonnet-4
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
# Direct-provider options (alternative to OpenRouter):
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GEMINI_API_KEY=

# --- Pipeline settings -----------------------------------------------------
CONFIDENCE_THRESHOLD=0.75
VALUATION_MAX_AGE_MONTHS=12
AREA_MISMATCH_TOLERANCE_PCT=2.0

# --- Storage ---------------------------------------------------------------
STORAGE_DIR=./storage

# --- Logging ---------------------------------------------------------------
LOG_LEVEL=INFO